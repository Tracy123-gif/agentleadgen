# Copy this file to .env and fill in your keys. Never commit the real .env.

# Search backend (Stage 1 candidate confirmation + Stage 2 deep research)
# Comma-separated, tried in order; the pipeline falls over to the next
# provider once one reports it's out of free-tier quota for this run.
SEARCH_PROVIDERS=tavily,google_cse
TAVILY_API_KEY=
BRAVE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Product Hunt (structured launch-date evidence — free, no OAuth dance
# needed, the developer token works directly as a Bearer token)
PRODUCTHUNT_DEVELOPER_TOKEN=

# Google Sheets output (optional, in addition to / instead of the local
# .xlsx). Needs: Sheets API enabled on your GCP project, a service account
# JSON key saved under credentials/ (gitignored), and a blank Google Sheet
# shared with that service account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json
GOOGLE_SHEET_ID=

# Claude API (Stage 2 analysis, classification, scoring rationale)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: cap spend / requests per run
MAX_SEARCH_QUERIES_PER_RUN=2000
MAX_CANDIDATES_STAGE2=500
